  "changelog": {
    "version": "0.2.6",
    "title": "River Client 0.2.6",
    "summary": "Glass menus and HUD, style settings for every module, a server browser and six new modules.",
    "items": [
      "New: Glass. Menus and the HUD blur the game behind them. Turn it off under Theme in Settings.",
      "New: Module styles. Every HUD module has Style settings: presets, glass, colors, rounded corners, bold and small caps text. One button puts a module's look on all the others.",
      "New: Server browser. A Servers button on the main menu and in Multiplayer lists popular servers with player counts. Join in one click or add one to your list.",
      "New: Six modules: TPS, Server Address, Saturation, Day Counter, Pack Display and Stopwatch.",
      "Improved: The River menu, Content, Cosmetics, Friends and module settings have a new look, with bold titles and small caps labels.",
      "Improved: Labels and notes across the client are shorter and plainer."
    ]
  },
  "notes": "Glass menus and HUD, style settings for every module, a server browser and six new modules."
}