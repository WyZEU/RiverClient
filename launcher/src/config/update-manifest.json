  "changelog": {
    "version": "0.2.7",
    "title": "River Client 0.2.7",
    "summary": "A texture picker, chat filters, a fixed instance import and the Modern launcher layout.",
    "items": [
      "New: Texture picker. The resource pack screen has a Texture picker button. Pick the texture for any item, block or other thing from any of your packs, with a 3D preview. 1.21.11 for now.",
      "New: Chat filters in Chat Tweaks. Hide repeated lines, ads and swearing. All three are off until you turn them on.",
      "New: Particle Effects, Auto GG and Cosmetics modules. Change hit particles and the crit colour, get one GG per game on servers, and hide other players' capes and badges.",
      "New: Start with Windows. Turn it on in Settings and River opens minimized when you sign in.",
      "Fixed: Importing an exported instance downloads the mods again. Mods that are not on Modrinth come along inside the file.",
      "Fixed: Lunar Client profiles are found in the folder they really live in.",
      "Improved: The launcher's Modern layout has a Minecraft landscape behind the window and frosted panels."
    ]
  },
  "notes": "A texture picker, chat filters, a fixed instance import and the Modern launcher layout."
}